{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "listing.yaml: what the Actuaria Market Place shows of a free dataset version",
  "description": "The written half of a listing. The rest (the task count, each project's count, the licence id, the registry) is read from the dataset itself into listing.json by scripts/listing.py.",
  "type": "object",
  "required": ["title", "summary", "description", "domain", "format", "licence", "upstream", "families", "you_get"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 60},
    "summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "description": {"type": "string", "minLength": 1},
    "domain": {"description": "the field, as a reader names it: Coding", "type": "string", "minLength": 1},
    "format": {"description": "how an answer is checked", "enum": ["run-tests"]},
    "licence": {
      "description": "the licence as a reader reads it; its SPDX id comes from source.yaml",
      "type": "object",
      "required": ["name", "summary"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}}
    },
    "upstream": {
      "description": "the work the dataset comes from, with credit",
      "type": "object",
      "required": ["name", "by", "url"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "by": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://[^\\s\"<>]+$"}
      }
    },
    "families": {
      "description": "the kind of work every task is: one entry, as no task names its own kind",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "name", "what"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "what": {"type": "string", "minLength": 1}
        }
      }
    },
    "lines": {
      "description": "repository: count the tasks by the repository their name starts with (owner__repo-<number>)",
      "enum": ["repository"]
    },
    "you_get": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "detail"],
        "additionalProperties": false,
        "properties": {"title": {"type": "string", "minLength": 1}, "detail": {"type": "string", "minLength": 1}}
      }
    }
  }
}
